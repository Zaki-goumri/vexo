# Copy to .env and adjust as needed.
# docker run --env-file .env ...  (or `env_file: .env` in docker-compose.yml)

# Directory where all persistent data lives: metadata db, object data,
# and the root credentials file (.vexo.root.key). Mount this as a volume.
VEXO_DATA_DIR=volume

# Listen address for the S3-compatible HTTP API (SigV4 auth).
VEXO_API_ADDR=:9090

# Listen address for the web console/dashboard (username+password login).
VEXO_CONSOLE_ADDR=:9091

# Listen address for the internal node-to-node P2P transport.
VEXO_P2P_ADDR=:3001

# Root/admin account, created once on first startup (only when the user
# store is empty). Leave VEXO_ROOT_PASSWORD unset to have a random 20-char
# password generated and printed to stdout / saved to
# $VEXO_DATA_DIR/.vexo.root.key on first run.
VEXO_ROOT_USER=admin
VEXO_ROOT_PASSWORD=admin
